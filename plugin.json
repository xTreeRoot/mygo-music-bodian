{
  "id": "bodian",
  "name": "波点音乐",
  "version": "0.3.5",
  "minAppVersion": "0.1.17",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": [
      "bd-api.kuwo.cn",
      "mlyric.kuwo.cn",
      "*.kuwo.cn",
      "qpic.y.qq.com"
    ]
  },
  "settings": [
    {
      "key": "quality",
      "label": "Quality Override",
      "help": "standard, high or lossless. Leave empty to follow the player."
    }
  ],
  "navigation": [
    {
      "title": "Discover",
      "builtin": "home",
      "icon": "home"
    },
    {
      "title": "Radio",
      "builtin": "stations",
      "icon": "radio"
    },
    {
      "title": "Charts",
      "page": "charts",
      "icon": "chart"
    },
    {
      "title": "Playlist Square",
      "page": "square",
      "icon": "playlist"
    },
    {
      "title": "Music Calendar",
      "page": "calendar",
      "icon": "calendar"
    },
    {
      "title": "Topics",
      "page": "topics",
      "icon": "podcast"
    },
    {
      "title": "Listening Stats",
      "page": "stats",
      "icon": "artist"
    },
    {
      "title": "Liked Songs",
      "builtin": "liked",
      "icon": "heart"
    }
  ],
  "requestHeaders": [
    {
      "hosts": [
        "*.kuwo.cn",
        "qpic.y.qq.com"
      ],
      "kinds": [
        "image",
        "audio"
      ],
      "headers": {
        "User-Agent": "Dart/3.3 (dart:io)"
      }
    }
  ]
}
